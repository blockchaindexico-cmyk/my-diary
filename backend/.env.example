# Anthropic API key used for entry analysis, the life profile, and chat.
ANTHROPIC_API_KEY=
# Claude model for analysis, profile, and chat.
CLAUDE_MODEL=claude-opus-5-5

# Long random string used to sign login tokens. Leave empty to auto-generate one into .jwt_secret,
# or set your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./diary.db

# Speech-to-text for voice entries:
#   local  - faster-whisper runs on this server; audio never leaves it (default, no key needed)
#   openai - OpenAI's hosted transcription; faster on small servers, needs OPENAI_API_KEY
TRANSCRIPTION_PROVIDER=local
# tiny | base | small | medium | large-v3  (bigger = more accurate, slower)
WHISPER_MODEL_SIZE=small
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Set to false to stop new sign-ups once your own account exists
ALLOW_SIGNUPS=true
