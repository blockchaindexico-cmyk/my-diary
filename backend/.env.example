# ---- AI ---------------------------------------------------------------------------------
# You can also pick the provider, model and key from the app (You → AI model);
# whatever you choose there overrides this file.
#
#   gemini      Google Gemini, free tier: key at https://aistudio.google.com/apikey
#   openrouter  Many models, some free (IDs ending in :free): https://openrouter.ai/keys
#   groq        Fast open models, free tier: https://console.groq.com/keys
#   ollama      Models running on this computer, free and private: https://ollama.com
#   openai      Paid
#   anthropic   Claude, paid
#   custom      Any other OpenAI-compatible API (set AI_BASE_URL)
AI_PROVIDER=gemini
# Leave blank for the provider's default (Gemini: gemini-flash-latest). For OpenRouter, Groq and
# Ollama, pick a model in the app or paste an ID here, e.g. one from openrouter.ai/models?q=free
AI_MODEL=
# Only for Ollama on another machine, or AI_PROVIDER=custom
AI_BASE_URL=

GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=

# Long random string used to sign login tokens. Leave empty to auto-generate one into .jwt_secret,
# or set your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./diary.db

# ---- Speech-to-text for voice entries -----------------------------------------------------
#   local   Whisper runs on this server: free, audio never leaves it (default)
#   groq    Groq's hosted Whisper: free tier, much faster on small servers (uses GROQ_API_KEY)
#   openai  OpenAI's hosted transcription: paid (uses OPENAI_API_KEY)
TRANSCRIPTION_PROVIDER=local
# tiny | base | small | medium | large-v3  (bigger = more accurate, slower)
WHISPER_MODEL_SIZE=small

# Set to false to stop new sign-ups once your own account exists
ALLOW_SIGNUPS=true
